{
  "compilerOptions": {
    /* ----------------------------------------------------
     * Basics
     * -------------------------------------------------- */
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "incremental": true,
    "noEmit": true,

    /* ----------------------------------------------------
     * Strictness 
     * -------------------------------------------------- */
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,

    /* ----------------------------------------------------
     * Plugins
     * -------------------------------------------------- */
    "plugins": [{ "name": "next" }],

    /* ----------------------------------------------------
     * Paths / aliases
     * -------------------------------------------------- */
    "baseUrl": ".",
    "paths": {
      "@/components/*": ["app/components/*"],
      "@/ui/*":        ["app/components/ui/*"],       // opcional, por legibilidad
      "@/hooks/*":     ["hooks/*"],
      "@/lib/*":       ["lib/*"],
      "@/types/*":     ["app/types/*"],
      "@/*":           ["app/*"]                      // alias genérico 
    }
  },

  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
